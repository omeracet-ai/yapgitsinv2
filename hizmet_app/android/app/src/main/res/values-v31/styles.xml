<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system SplashScreen API.
         Sistem splash icon'unu transparent yap (Y kırpma sorunu); dark bg
         hemen Flutter SplashScreen'e devreder ki tam Yapgitsin logosu görünsün. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#FF0C1117</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
